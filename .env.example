# ---------------------------------------------------------------------------
# Utkal Yatra — environment template. Copy to .env for local development.
# Never commit real credentials. In production these values come from the
# platform secret store (e.g. /run/base44/app.env), not from the repository.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (local compose Postgres, Supabase pooler, etc.)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/utkalyatra"

# Signing key for customer/admin session cookies (min 16 chars).
SESSION_SECRET="change-me-to-a-long-random-string"

# Seeded administrator account. The admin row is created on first boot.
ADMIN_EMAIL="admin@utkalyatra.in"
ADMIN_PASSWORD="Admin@12345"

# Razorpay (server-side only). The key id is safe to expose to the browser;
# the key secret must never be shipped to the client.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email confirmations (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Utkal Yatra <tickets@utkalyatra.in>"

# SMS confirmations (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Public brand / support defaults (editable later from Admin → Website content)
WHATSAPP_NUMBER="919090909090"
APP_URL=""

# Server port
PORT="3000"
